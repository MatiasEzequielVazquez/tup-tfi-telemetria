<mxfile host="app.diagrams.net"><diagram name="Proceso actual" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Proceso actual de control de mantenimiento (caso de estudio)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="a" value="Camión vuelve de viaje" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="b" value="Chofer informa kilometraje&lt;br&gt;y novedades de palabra" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE2E1;strokeColor=#C0392B;fontColor=#7B241C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="160" width="240" height="60" as="geometry"/></mxCell><mxCell id="c" value="Responsable de mantenimiento&lt;br&gt;actualiza la libreta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDE2E1;strokeColor=#C0392B;fontColor=#7B241C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="260" width="240" height="60" as="geometry"/></mxCell><mxCell id="dd" value="¿Corresponde service&lt;br&gt;por km o hay falla?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="360" width="200" height="110" as="geometry"/></mxCell><mxCell id="e" value="¿Hay lugar en el taller&lt;br&gt;y tiempo antes de salir?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="510" width="200" height="110" as="geometry"/></mxCell><mxCell id="f" value="Se realiza el service&lt;br&gt;y se anota en la li