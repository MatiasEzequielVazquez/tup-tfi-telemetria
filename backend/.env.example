# Sistema de Telemetría Vehicular — Backend
# Copiar a backend/.env y completar. Nunca subir el .env al repositorio.
# Descripción de cada variable: backend/README.md

# Base de datos — Supabase → Connect → Session pooler (funciona por IPv4)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Autenticación — dev (tokens de prueba) o supabase (obligatorio en producción)
AUTH_MODE=dev
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
AUTH_CACHE_SEGUNDOS=60

# MQTT — HiveMQ CE (local: mqtt://localhost:1883 con docker-compose.dev.yml)
# Sin MQTT_BROKER_URL la ingesta queda deshabilitada.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_LECTURAS=telemetria/+/lecturas
# Un solo backend por broker: no conectar el local al broker de producción.
MQTT_CLIENT_ID=tfi-backend

# API REST
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Reglas de negocio
PLAZO_DISPOSITIVO_SIN_REPORTAR_HORAS=24
TEMPORIZADOR_INTERVALO_MINUTOS=5
ZONA_HORARIA=America/Argentina/Buenos_Aires
TOLERANCIA_FUTURO_MINUTOS=10