# Simulador de camiones — conexión al broker MQTT.
# Copiar a simuladores-mock/.env y completar. Nunca subir el .env al repositorio.
# Las variables del entorno pisan a las de este archivo.

# En la VM el broker escucha por TLS en el 8883 (el 1883 es solo interno de Docker).
# Local (backend/docker-compose.dev.yml): mqtt://localhost:1883
MQTT_BROKER_URL=mqtts://157-151-13-187.sslip.io:8883

# Usuario "simulador" de deploy/hivemq/.../credentials.xml: puede publicar en telemetria/+/lecturas.
MQTT_USERNAME=simulador
MQTT_PASSWORD=

# Opcionales
# MQTT_TOPIC_LECTURAS=telemetria/+/lecturas
# MQTT_CLIENT_ID=tfi-simulador-pc
# MQTT_CA_FILE=C:\ruta\a\ca.pem
