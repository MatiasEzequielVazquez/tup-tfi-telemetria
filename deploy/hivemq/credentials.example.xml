<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Usuarios y permisos MQTT (extensión HiveMQ File RBAC). Copiar a
     hivemq/extensions/hivemq-file-rbac-extension/conf/credentials.xml y cambiar las contraseñas. -->
<file-rbac>
    <users>
        <user>
            <name>backend</name>
            <password>CAMBIAR-backend</password>
            <roles><id>backend</id></roles>
        </user>
        <user>
            <name>simulador</name>
            <password>CAMBIAR-simulador</password>
            <roles><id>simulador</id></roles>
        </user>
        <!-- Un usuario por ESP32: el nombre es su device_uid (RNF03). -->
        <user>
            <name>esp32-B4D43E</name>
            <password>CAMBIAR-dispositivo</password>
            <roles><id>dispositivo</id></roles>
        </user>
    </users>
    <roles>
        <role>
            <id>backend</id>
            <permissions>
                <permission>
                    <topic>telemetria/+/lecturas</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>simulador</id>
            <permissions>
                <permission>
                    <topic>telemetria/+/lecturas</topic>
                    <activity>PUBLISH</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <!-- Cada dispositivo solo puede publicar en SU topic: ${{username}} es su device_uid. -->
            <id>dispositivo</id>
            <permissions>
                <permission>
                    <topic>telemetria/${{username}}/lecturas</topic>
                    <activity>PUBLISH</activity>
                </permission>
            </permissions>
        </role>
    </roles>
</file-rbac>