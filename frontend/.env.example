# URL base de la API REST (incluye el prefijo /api/v1).
# Con el mock: node mock/server.js escucha en el puerto 3000.
# Copiar este archivo a frontend/.env y reiniciar Vite si se cambia.
VITE_API_URL=http://localhost:3000/api/v1

# Origen de la sesión:
#   dev       rol simulado (el token es el rol). Para el mock o un backend con AUTH_MODE=dev.
#   supabase  login real con Supabase Auth (obligatorio en producción).
VITE_AUTH_MODE=dev

# Solo con VITE_AUTH_MODE=supabase. Supabase → Project Settings → API.
# La clave anon es pública por diseño; nunca poner acá la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
