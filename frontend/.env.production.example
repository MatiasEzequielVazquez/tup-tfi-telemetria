# Variables del build de producción (npm run build).
# Copiar este archivo a frontend/.env.production y completar antes de compilar.
# El dashboard y la API comparten dominio (Caddy), así que la URL base es relativa.
VITE_API_URL=/api/v1

# En producción la sesión es siempre Supabase (VITE_AUTH_MODE=dev se rechaza).
# Supabase → Project Settings → API. La clave anon es pública por diseño; nunca poner acá la service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
